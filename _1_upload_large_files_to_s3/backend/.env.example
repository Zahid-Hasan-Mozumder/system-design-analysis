# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/s3_uploads?schema=public"

# ---------------------------------------------------------------------------
# S3 / MinIO
# ---------------------------------------------------------------------------
# Any value works for MinIO; it ignores the region but the SDK requires one.
AWS_REGION=us-east-1
S3_BUCKET=test
# MinIO access key / secret (the console credentials, or a service account).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO endpoint. Use the URL the BROWSER can reach -- presigned URLs embed this
# host, so a server-only hostname (e.g. the docker service name) will not work.
#   Local MinIO:   http://localhost:9000
#   Behind a proxy: https://s3.your-domain.com
S3_ENDPOINT=http://localhost:9000
# MinIO uses path-style addressing (host/bucket/key). Keep this true, otherwise
# presigned URLs point at bucket.host, which usually does not resolve.
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if it is missing (handy for local MinIO dev).
S3_AUTO_CREATE_BUCKET=false

# For real AWS S3 instead of MinIO: leave S3_ENDPOINT blank, set
# S3_FORCE_PATH_STYLE=false, and use your AWS region + IAM credentials.

# ---------------------------------------------------------------------------
# Multipart upload tuning
# ---------------------------------------------------------------------------
# Minimum S3 part size is 5 MiB. 16 MiB keeps a 2 GB file at ~128 parts.
UPLOAD_PART_SIZE_BYTES=16777216
# Hard ceiling on accepted file size. Default 5 TiB (the S3 object limit).
UPLOAD_MAX_FILE_BYTES=5497558138880
# How long each presigned part URL stays valid, in seconds.
UPLOAD_URL_TTL_SECONDS=3600
# Prefix every object key gets inside the bucket.
UPLOAD_KEY_PREFIX=uploads
